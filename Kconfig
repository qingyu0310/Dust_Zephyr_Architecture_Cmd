config CMD_SHELL_VAR
    bool "Enable debug variable interaction (l/g/s commands)"
    default n
    select COM_UART_DMA
    help
        Enable a self-maintained UART polling thread for debug variable
        interaction. Commands: l (list), g <name> (get), s <name> <v> (set).
        Threads register variables via REGISTER_SHELL_VAR().

config CMD_BUZZER
    bool "Enable PWM buzzer control"
    default n
    select DEV_PWM
    help
        Enable buzzer control class based on PWM output.
